# SaaS deployment example.
# Copy to .env.saas.local locally or set these values in the SaaS Vercel Project.
# Never commit .env.saas.local or real secrets.

APP_MODE=saas
SAAS_ALLOWED_BRANCH=develop-saas
BRANCH_POLICY_STRICT=true
ENABLE_PUBLIC_SIGNUP=false
ENABLE_PUBLIC_LEAD_CAPTURE=false
ENABLE_GOOGLE_AUTH=false
ENABLE_GOOGLE_TRIAL_SIGNUP=false
ENABLE_TRIAL_EXPIRY_CRON=false
ENABLE_BILLING=false
ENABLE_SUBSCRIPTION_PLAN=false
ENABLE_AI_USAGE_LIMIT=true
ENABLE_ADVANCED_ANALYTICS=false
ENABLE_MULTI_TENANT_ADMIN=false
ENABLE_IMAGE_AI=false

# Local checkout/project safety.
SAAS_VERCEL_PROJECT_NAME=smart-return-system-saas
SAAS_VERCEL_PROJECT_ID=prj_VdkRrS4UJEvipSG8OMCXXkUmt3i8
INTERNAL_VERCEL_PROJECT_ID=prj_aaRiMeML9D4G7U71QRDZYVonLH8h

# Public app URL for the SaaS Vercel Project.
NEXT_PUBLIC_APP_URL=https://app.your-saas-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-saas-domain.com
# LINE Official Account ID for marketing lead capture (e.g. @smartreturn).
# Leave empty to hide the LINE button on /signup and /contact.
NEXT_PUBLIC_LINE_OA_ID=

# SaaS Supabase Project only. Do not use the internal/live project here.
NEXT_PUBLIC_SUPABASE_URL=https://your-saas-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_saas_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_saas_service_role_key
SUPABASE_PROJECT_ID_EXPECTED=your-saas-project-ref
SAAS_SUPABASE_PROJECT_ID=your-saas-project-ref

# Internal/live project ref is used only for fail-fast safety checks.
INTERNAL_SUPABASE_PROJECT_ID=fdzfnenizyppxglypden

# SaaS AI key and limits.
GEMINI_API_KEY=replace_with_saas_gemini_api_key
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=1200
AI_ANALYSIS_CACHE_ENABLED=true

# Server-side secrets.
ADMIN_USERNAME=admin
# Optional admin email alias. With ADMIN_USERNAME=admin, admin@example.com is also accepted.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_admin_password_12_plus_chars
ADMIN_SESSION_SECRET=replace_with_32_plus_char_random_secret
CRON_SECRET=replace_with_32_plus_char_random_secret
SCHEMA_DRIFT_ALERT_TOKEN=replace_with_32_plus_char_random_secret
SCHEMA_DRIFT_ALERT_WEBHOOK_URL=
# SaaS Sentry project only. Do not commit real DSN values.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional source map upload token; leave empty unless owner explicitly enables it.
SENTRY_AUTH_TOKEN=

# Scan / cron alert thresholds.
RECONCILE_CRON_AUTO_FIX=1
RECONCILE_COMPARE_AMOUNT=1
SHOPEE_SCAN_SLA_HOURS=24
SHOPEE_SCAN_UNMATCHED_RATE_ALERT_THRESHOLD=25
SHOPEE_SCAN_DUPLICATE_RATE_ALERT_THRESHOLD=35
SHOPEE_SCAN_STALE_UNMATCHED_ALERT_THRESHOLD=1

# Optional future billing credentials. Keep empty until billing is enabled.
BILLING_PROVIDER=
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
TAPPAY_PARTNER_KEY=
TAPPAY_MERCHANT_ID=
TAPPAY_APP_ID=
TAPPAY_APP_KEY=
TAPPAY_MODE=test
