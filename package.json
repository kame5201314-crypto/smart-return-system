{
  "name": "smart-return-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run prebuild:branch-policy && npm run prebuild:check && npm run prebuild:schema-gate && npm run prebuild:alerts && npm run prebuild:consistency && npm run prebuild:encoding && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:ui",
    "test:scripts": "node scripts/testing/validate-node-scripts.mjs",
    "test:backend": "vitest run tests/backend tests/unit/upload-session.route.test.ts tests/unit/upload-signed-url.route.test.ts tests/unit/shopee-scan.actions.test.ts tests/unit/shopee-status-separation.test.ts",
    "test:scripts-backend": "npm run test:scripts && npm run test:backend",
    "test:all": "npm run test:scripts-backend && npm run test:unit && npm run test:ui && npm run test:e2e && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:ui": "vitest run tests/ui",
    "test:e2e": "vitest run tests/e2e",
    "test:e2e-all": "npm run test:e2e && npm run test:ui && npm run test:backend",
    "test:integration": "vitest run tests/integration",
    "audit:prod:high": "npm audit --omit=dev --audit-level=high",
    "verify-env": "node scripts/verify-env.mjs",
    "saas:verify-checkout": "node scripts/saas/verify-saas-checkout.mjs",
    "saas:verify-env": "node scripts/saas/run-with-saas-env.mjs npm run verify-env",
    "saas:build": "node scripts/saas/run-with-saas-env.mjs npm run build",
    "saas:doctor": "node scripts/saas/readiness-check.mjs",
    "saas:doctor:strict": "node scripts/saas/readiness-check.mjs --strict",
    "saas:migration-plan": "node scripts/saas/run-with-saas-env.mjs node scripts/saas/check-migration-plan.mjs",
    "saas:migration-plan:strict": "node scripts/saas/run-with-saas-env.mjs node scripts/saas/check-migration-plan.mjs --strict",
    "saas:schema-gate": "node scripts/saas/run-with-saas-env.mjs node scripts/saas/check-saas-schema-readiness.mjs",
    "saas:schema-gate:strict": "node scripts/saas/run-with-saas-env.mjs node scripts/saas/check-saas-schema-readiness.mjs --strict",
    "saas:rollout-check": "node scripts/saas/run-with-saas-env.mjs node scripts/saas/check-rollout-readiness.mjs",
    "saas:rollout-check:strict": "node scripts/saas/run-with-saas-env.mjs node scripts/saas/check-rollout-readiness.mjs --strict",
    "saas:production-smoke": "node scripts/saas/production-smoke.mjs",
    "saas:predeploy": "npm run saas:verify-checkout && npm run saas:verify-env && npm run saas:rollout-check && npm run saas:schema-gate && npm run lint && npm run typecheck && npm run test:all && npm run saas:build",
    "safety:agent-boundary": "node scripts/safety/check-agent-boundary.mjs",
    "prebuild:branch-policy": "node scripts/predeploy/check-branch-policy.mjs",
    "prebuild:check": "node scripts/predeploy/check-supabase-project.mjs",
    "prebuild:schema-gate": "node scripts/predeploy/schema-gate.mjs",
    "prebuild:alerts": "node scripts/predeploy/check-alert-config.mjs",
    "prebuild:consistency": "node scripts/predeploy/check-ai-analytics-consistency.mjs",
    "prebuild:encoding": "node scripts/predeploy/check-encoding-hygiene.mjs",
    "maintenance:reconcile-ai-totals": "node scripts/maintenance/reconcile-ai-report-totals.mjs",
    "maintenance:cron-drill": "node scripts/maintenance/cron-drill.mjs",
    "maintenance:smoke-shopee-scan": "node scripts/maintenance/postdeploy-shopee-scan-smoke.mjs",
    "maintenance:shopee-inbound-backfill": "node scripts/maintenance/shopee-inbound-backfill-with-snapshot.mjs",
    "maintenance:archive-scan-retention": "node scripts/maintenance/archive-scan-retention.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@marsidev/react-turnstile": "1.5.3",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.562.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "openai": "^6.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.69.0",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
