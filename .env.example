# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
ADMIN_USERNAME=admin
# Optional admin email alias. With ADMIN_USERNAME=admin, admin@example.com is also accepted.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_a_strong_password
ADMIN_SESSION_SECRET=change_me_to_a_random_32_plus_char_secret

# AI Analysis
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
AI_ANALYSIS_CACHE_ENABLED=true
SCHEMA_DRIFT_ALERT_WEBHOOK_URL=
SCHEMA_DRIFT_ALERT_TOKEN=change_this_to_a_long_random_secret
RECONCILE_CRON_AUTO_FIX=1
RECONCILE_COMPARE_AMOUNT=1
CRON_SECRET=change_this_to_a_long_random_secret
SHOPEE_SCAN_SLA_HOURS=24
SHOPEE_SCAN_UNMATCHED_RATE_ALERT_THRESHOLD=25
SHOPEE_SCAN_DUPLICATE_RATE_ALERT_THRESHOLD=35
SHOPEE_SCAN_STALE_UNMATCHED_ALERT_THRESHOLD=1

# Application Settings
APP_MODE=internal
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_PROJECT_ID_EXPECTED=
INTERNAL_SUPABASE_PROJECT_ID=
SAAS_SUPABASE_PROJECT_ID=
ENABLE_PUBLIC_SIGNUP=false
ENABLE_PUBLIC_LEAD_CAPTURE=false
ENABLE_GOOGLE_AUTH=false
# Public Google buttons stay hidden unless this independent UI switch is enabled.
ENABLE_GOOGLE_AUTH_UI=false
ENABLE_GOOGLE_TRIAL_SIGNUP=false
ENABLE_INVITE_ONLY_BETA=false
SAAS_BETA_ALLOWED_EMAILS=
ENABLE_TRIAL_EXPIRY_CRON=false
ENABLE_PAID_PERIOD_EXPIRY_CRON=false
SAAS_TRIAL_EXPIRY_BATCH_LIMIT=50
SAAS_PAID_PERIOD_EXPIRY_BATCH_LIMIT=50

# Return Policy Settings (in days)
RETURN_APPLICATION_DEADLINE_DAYS=7

# Predeploy consistency / schema controls (optional)
CONSISTENCY_CHECK_PERIOD=
CONSISTENCY_CHECK_STRICT=
SCHEMA_GATE_BYPASS=
ALERT_CONFIG_BYPASS=

# Local admin login (optional)
ADMIN_USERNAME=admin
# Optional admin email alias. With ADMIN_USERNAME=admin, admin@example.com is also accepted.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
ADMIN_SESSION_SECRET=change_this_long_random_secret
